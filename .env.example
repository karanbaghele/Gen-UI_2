# Copy to .env.local. Keep this file local; do not commit credentials.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
APP_URL=http://127.0.0.1:3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Generate locally with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=http://127.0.0.1:3000/auth/google-sheets/callback

# Google is the only normal user-facing sign-in provider.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
# Hosted Supabase stores its Google provider credentials in Auth settings.
# Set this on Vercel only after enabling that provider.
# GOOGLE_SIGN_IN_ENABLED=true

# Optional AI providers. Ollama must be a loopback URL.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_CALL_LIMIT=12
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
GENUI_WORKER_INDEX_ONLY=true
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# Set to nvidia for real hosted RAG; omit to use NVIDIA when its key is set.
EMBEDDING_PROVIDER=nvidia
AI_PROVIDER=nvidia
# On Vercel, index selected datasets during generation instead of relying on a worker.
# GENUI_ON_DEMAND_INDEXING=true
# NEXT_PUBLIC_HOSTED=true

# Test-only fixture. It is rejected in production and no app endpoint enables it.
# GENUI_TEST_AUTH=true
